# Copy to .env and fill in. .env is ignored by git.

# PostgreSQL (docker-compose creates the database with these values)
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transcendence

# Used by Prisma and the app. In Docker the host is "db" (set in docker-compose.yml);
# for `bun run dev` the dev database listens on localhost.
DATABASE_URL=postgresql://transcendence:change-me@localhost:5432/transcendence?schema=public

# Better Auth: secret used to sign session cookies (generate one with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Public URL of the site for `bun run dev`. Docker sets it to https://localhost:<HTTPS_PORT>.
BETTER_AUTH_URL=http://localhost:3000

# HTTPS port of nginx in Docker (8443: the rootless Docker of the 42 computers can't use 443)
HTTPS_PORT=8443

# Login with 42 (optional). Create an app on https://profile.intra.42.fr/oauth/applications
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/42
# (e.g. http://localhost:3000/api/auth/callback/42 and https://localhost:8443/api/auth/callback/42)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
