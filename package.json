{
  "name": "42transcendance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun server.ts",
    "build": "next build",
    "start": "NODE_ENV=production bun server.ts",
    "lint": "eslint",
    "postinstall": "bun x --bun prisma generate",
    "dev:next": "next dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "bun --env-file=.env --bun x prisma migrate dev",
    "db:deploy": "bun x --bun prisma migrate deploy",
    "db:studio": "bun --env-file=.env --bun x prisma studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "next": "16.3.0",
    "next-intl": "^4.14.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
